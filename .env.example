#==============================================================================
# SaniTi · configuración
#
# Copie este archivo a .env.local y complete los valores.
# .env.local está en .gitignore y NUNCA debe subirse al repositorio.
#==============================================================================

#------------------------------------------------------------------------------
# Supabase
#------------------------------------------------------------------------------
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IGNORA RLS POR COMPLETO. Con esta clave se lee la historia clínica de
# cualquier paciente de cualquier institución.
#   · Sólo en el servidor. Jamás con prefijo NEXT_PUBLIC_.
#   · Sólo en webhooks y jobs, nunca en código que atienda a un usuario.
#   · Si se filtra, rótela de inmediato desde el panel de Supabase.
SUPABASE_SERVICE_ROLE_KEY=

#------------------------------------------------------------------------------
# Cifrado de datos clínicos
#------------------------------------------------------------------------------
# Claves AES-256 en base64, indexadas por versión, para poder rotar sin
# descifrar todo el histórico: se cifra con la activa y se sigue leyendo lo
# cifrado con las anteriores.
#
# Genere cada clave con:
#     openssl rand -base64 32
#
# ADVERTENCIA: si pierde estas claves, las cédulas y las notas clínicas ya
# guardadas son IRRECUPERABLES. No existe puerta trasera. Guárdelas en un
# gestor de secretos con respaldo, no sólo en el .env de un portátil.
#
# NUNCA retire una versión mientras queden filas cifradas con ella. Antes de
# eliminarla, verifique con:
#     select key_version, count(*) from clinical_notes group by key_version;
SANITI_ENCRYPTION_KEYS={"1":"REEMPLACE_ESTO_openssl_rand_base64_32"}
SANITI_ACTIVE_KEY_VERSION=1

# Clave del índice ciego, para buscar por cédula sin guardarla en claro.
# Distinta de las de cifrado: ésta viaja en las consultas y puede aparecer en
# los logs de sentencias lentas, así que se le supone más expuesta.
#
# Cambiarla invalida TODAS las búsquedas por documento existentes: habría que
# recalcular el índice de cada paciente.
SANITI_BLIND_INDEX_KEY=REEMPLACE_ESTO_openssl_rand_base64_32

#------------------------------------------------------------------------------
# WhatsApp Cloud API (Meta)
#------------------------------------------------------------------------------
# developers.facebook.com → su app → WhatsApp → Configuración de la API
# Opcional: sin estas variables SaniTi funciona, sólo queda deshabilitado el
# agendamiento por WhatsApp. Pero han de estar las CUATRO o ninguna: media
# configuración deja el webhook aceptando eventos que no puede verificar.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Cadena que usted inventa; Meta la devuelve al dar de alta el webhook.
WHATSAPP_VERIFY_TOKEN=
# App Secret de Meta. Valida la firma X-Hub-Signature-256 de cada evento
# entrante: sin él, cualquiera que descubra la URL puede agendar citas falsas.
WHATSAPP_APP_SECRET=

#------------------------------------------------------------------------------
# Entorno
#------------------------------------------------------------------------------
APP_URL=http://localhost:3000

#------------------------------------------------------------------------------
# Sólo para herramientas de desarrollo (migraciones, comprobación de deriva
# del esquema). NO la usa la aplicación en tiempo de ejecución.
# Panel de Supabase → Project Settings → Database → Connection string
#------------------------------------------------------------------------------
DATABASE_URL=

#------------------------------------------------------------------------------
# Antivirus (obligatorio en producción)
#------------------------------------------------------------------------------
# ClamAV autoalojado. NO se usa un servicio en la nube a propósito: un estudio
# de laboratorio lleva el nombre y el diagnóstico del paciente, así que enviarlo
# a una API externa sería una transferencia de datos de salud a un tercero.
#
# En local:  docker compose -f docker-compose.clamav.yml up -d
#
# Si falta esta variable, en producción el arranque FALLA. Es intencional:
# degradarse en silencio a "no analizar nada" es peor que no arrancar.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
