{
  "name": "saniti",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:sql": "node scripts/check-sql.mjs",
    "check:drift": "node scripts/check-schema-drift.mjs",
    "verify": "npm run check:sql && npm run typecheck && npm run lint && npm run test && npm run check:drift",
    "graph": "graphify update . --scope all",
    "graph:report": "graphify summary",
    "icons": "tsx scripts/build-icons.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:studio": "echo Supabase Studio: http://127.0.0.1:54323",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/db/database.types.ts",
    "scan": "tsx scripts/scan-documents.mts",
    "scan:watch": "tsx scripts/scan-documents.mts --watch",
    "av:start": "docker compose -f docker-compose.clamav.yml up -d",
    "av:stop": "docker compose -f docker-compose.clamav.yml down"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sentropic/graphify": "^0.17.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "pgsql-parser": "^18.2.6",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "description": "SaniTi — plataforma de gestión clínica multi-institución"
}
