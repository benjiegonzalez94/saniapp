# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ninguno se versiona: contienen claves de cifrado de datos
# clínicos y la clave de servicio, que ignora RLS por completo.
.env*
# ...salvo la plantilla, que documenta qué hay que configurar y no lleva
# ningún valor real.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify — grafo de conocimiento del repositorio.
# No se versiona: manifest.json guarda rutas absolutas de la máquina que lo
# generó (`npx graphify portable-check` lo confirma) y graph.json + cache suman
# ~640 KB de artefacto regenerable con `npm run graph`.
.graphify/
